# ==========================================
# 🎸 코드 파지 정오 판별 (템플릿 매칭)
# 새 사진 -> MediaPipe로 좌표 추출 -> 저장된 코드 템플릿과 비교
# ==========================================
#
# ⚠️ 실행 환경 (필수):
#   - Python 3.10 ~ 3.11 (mediapipe는 3.13 미지원)
#   - mediapipe 0.10.x 버전 (1.0.x는 macOS에서 크래시 버그 있음)
#
# 이 스크립트가 하는 일:
#   1) 새 사진에서 손 관절 좌표(21개) 추출
#   2) 손목 기준 상대좌표로 변환 (rel)
#   3) 손목~중지MCP 거리로 정규화 (norm) — a_normalized.csv와 동일한 방식
#   4) 미리 만들어둔 코드 템플릿(a_template.csv)과의 거리 계산
#   5) 거리가 임계값(THRESHOLD) 이하면 "맞음", 초과하면 "틀림" 판정
#   6) 어느 손가락이 가장 많이 벗어났는지도 함께 출력

import os
import csv
import glob
import numpy as np
import mediapipe as mp

from mediapipe.tasks import python
from mediapipe.tasks.python import vision


# ==========================================
# 1. 경로 설정
# ==========================================

MODEL_PATH = "/Users/ujiho/스파이더/hand_landmarker.task"

# 비교할 템플릿 CSV (a_template.csv 같은 파일)
# 템플릿 CSV는 ",A_template_mean" 형태의 2열 구조여야 함
TEMPLATE_PATH = "/Users/ujiho/스파이더/ai 학습자료/a코드/a_template.csv"
TEMPLATE_CHORD_NAME = "A"  # 이 템플릿이 어떤 코드인지 (출력 메시지용)

# 판별할 새 사진 (파일 하나) 또는 폴더 (그 안의 모든 사진을 하나씩 판별)
TARGET_PATH = "/Users/ujiho/스파이더/ai 학습자료/a코드_test"

# 판정 기준 거리 (이 값 이하면 "맞음")
# a_similarity.csv의 기존 10장 거리가 2.28~4.30 범위였고 평균 3.19, 표준편차 0.69였음.
# 지금은 "A코드가 아닌 사진"으로 검증해본 적이 없어서 이 값은 잠정치임.
# 다른 코드 사진으로 이 스크립트를 돌려보면서 값을 조정해나가는 걸 권장.
THRESHOLD = 4.0

IMAGE_EXTENSIONS = ("*.jpg", "*.jpeg", "*.png", "*.JPG", "*.JPEG", "*.PNG")

# 손가락 이름 매핑 (MediaPipe landmark index -> 관절 이름)
LANDMARK_NAMES = {
    0: "손목",
    1: "엄지 (CMC)", 2: "엄지 (MCP)", 3: "엄지 (IP)", 4: "엄지 (끝)",
    5: "검지 (MCP)", 6: "검지 (PIP)", 7: "검지 (DIP)", 8: "검지 (끝)",
    9: "중지 (MCP)", 10: "중지 (PIP)", 11: "중지 (DIP)", 12: "중지 (끝)",
    13: "약지 (MCP)", 14: "약지 (PIP)", 15: "약지 (DIP)", 16: "약지 (끝)",
    17: "소지 (MCP)", 18: "소지 (PIP)", 19: "소지 (DIP)", 20: "소지 (끝)",
}


# ==========================================
# 2. 템플릿 로드
# ==========================================

def load_template(template_path):
    if not os.path.isfile(template_path):
        print(f"❌ 템플릿 파일이 없습니다: {template_path}")
        raise FileNotFoundError(template_path)

    template = {}
    with open(template_path, "r", encoding="utf-8-sig") as f:
        reader = csv.reader(f)
        header = next(reader)  # [ "", "A_template_mean" ]
        for row in reader:
            key, value = row[0], row[1]
            template[key] = float(value)

    return template


def template_to_vector(template):
    """landmark 순서(0~20) x,y,z 순서로 63차원 벡터를 만든다."""
    vec = []
    cols = []
    for i in range(21):
        for axis in ("x", "y", "z"):
            col = f"lm{i}_norm_{axis}"
            vec.append(template[col])
            cols.append(col)
    return np.array(vec), cols


# ==========================================
# 3. MediaPipe Hand Landmarker 생성
# ==========================================

def create_detector():
    try:
        base_options = python.BaseOptions(model_asset_path=MODEL_PATH)
        options = vision.HandLandmarkerOptions(
            base_options=base_options,
            running_mode=vision.RunningMode.IMAGE,
            num_hands=1,
            min_hand_detection_confidence=0.5,
            min_hand_presence_confidence=0.5,
            min_tracking_confidence=0.5
        )
        detector = vision.HandLandmarker.create_from_options(options)
    except Exception as e:
        print("❌ HandLandmarker 생성 실패")
        print(f"에러 내용: {e}")
        print("확인해볼 것: python 3.10~3.11 환경인지 / mediapipe가 0.10.x인지")
        raise

    return detector


# ==========================================
# 4. 좌표 추출 + rel/norm 변환 (a_normalized.csv와 동일한 로직)
# ==========================================

def extract_norm_vector(detector, image_path):
    image = mp.Image.create_from_file(image_path)
    result = detector.detect(image)

    if len(result.hand_landmarks) == 0:
        return None

    hand = result.hand_landmarks[0]
    raw = np.array([[lm.x, lm.y, lm.z] for lm in hand])  # shape (21, 3)

    # rel: 손목(landmark 0) 기준 상대좌표
    rel = raw - raw[0]

    # scale: 손목 ~ 중지 MCP(landmark 9) 거리의 역수
    wrist_to_mid_mcp = np.linalg.norm(rel[9])
    if wrist_to_mid_mcp == 0:
        return None
    scale = 1.0 / wrist_to_mid_mcp

    norm = rel * scale  # shape (21, 3)
    return norm.flatten()  # 63차원 벡터 (lm0_x,lm0_y,lm0_z, lm1_x, ... 순서)


# ==========================================
# 5. 손가락별 오차 breakdown
# ==========================================

def per_landmark_breakdown(sample_vec, template_vec, top_n=3):
    sample_pts = sample_vec.reshape(21, 3)
    template_pts = template_vec.reshape(21, 3)
    per_point_dist = np.linalg.norm(sample_pts - template_pts, axis=1)  # (21,)

    order = np.argsort(-per_point_dist)  # 큰 순서대로
    top = []
    for idx in order[:top_n]:
        top.append((LANDMARK_NAMES.get(idx, f"landmark {idx}"), per_point_dist[idx]))
    return top


# ==========================================
# 6. 사진 하나 판별
# ==========================================

def judge_one(detector, image_path, template_vec, template_cols):
    filename = os.path.basename(image_path)
    print()
    print(f"[{filename}] 판별 중...")

    sample_vec = extract_norm_vector(detector, image_path)

    if sample_vec is None:
        print("  ❌ 손을 찾지 못했습니다. (판별 불가)")
        return None

    distance = float(np.linalg.norm(sample_vec - template_vec))
    is_match = distance <= THRESHOLD

    verdict = "✅ 맞음" if is_match else "❌ 틀림"
    print(f"  {TEMPLATE_CHORD_NAME}코드 템플릿과의 거리: {distance:.4f}  (기준: {THRESHOLD})")
    print(f"  판정: {verdict}")

    breakdown = per_landmark_breakdown(sample_vec, template_vec)
    print("  가장 많이 벗어난 부위 TOP 3:")
    for name, dist in breakdown:
        print(f"    - {name}: {dist:.4f}")

    return {
        "filename": filename,
        "distance": distance,
        "verdict": "맞음" if is_match else "틀림",
        "top1_landmark": breakdown[0][0],
        "top1_distance": breakdown[0][1],
    }


# ==========================================
# 메인 실행
# ==========================================

def main():
    print("----------------------------------------")
    print("템플릿 로드")
    print("----------------------------------------")
    template = load_template(TEMPLATE_PATH)
    template_vec, template_cols = template_to_vector(template)
    print(f"✅ {TEMPLATE_CHORD_NAME}코드 템플릿 로드 완료 ({len(template_vec)}차원)")

    print()
    print("----------------------------------------")
    print("판별 대상 확인")
    print("----------------------------------------")

    if os.path.isdir(TARGET_PATH):
        image_paths = []
        for ext in IMAGE_EXTENSIONS:
            image_paths.extend(glob.glob(os.path.join(TARGET_PATH, ext)))
        image_paths = sorted(set(image_paths))
        if len(image_paths) == 0:
            print(f"❌ 폴더 안에 이미지가 없습니다: {TARGET_PATH}")
            raise FileNotFoundError(TARGET_PATH)
        print(f"✅ 폴더 모드: 이미지 {len(image_paths)}장")
    elif os.path.isfile(TARGET_PATH):
        image_paths = [TARGET_PATH]
        print("✅ 단일 파일 모드")
    else:
        print(f"❌ 경로를 찾을 수 없습니다: {TARGET_PATH}")
        raise FileNotFoundError(TARGET_PATH)

    detector = create_detector()

    print()
    print("----------------------------------------")
    print("판별 시작")
    print("----------------------------------------")

    results = []
    try:
        for image_path in image_paths:
            r = judge_one(detector, image_path, template_vec, template_cols)
            if r is not None:
                results.append(r)
    finally:
        detector.close()

    # 결과 요약 저장
    if results:
        out_path = os.path.join(
            TARGET_PATH if os.path.isdir(TARGET_PATH) else os.path.dirname(TARGET_PATH),
            "judge_result.csv"
        )
        with open(out_path, "w", newline="", encoding="utf-8-sig") as f:
            writer = csv.DictWriter(f, fieldnames=["filename", "distance", "verdict", "top1_landmark", "top1_distance"])
            writer.writeheader()
            writer.writerows(results)

        print()
        print("----------------------------------------")
        print("결과 저장")
        print("----------------------------------------")
        print(f"✅ 판별 결과 저장 완료: {out_path}")

        match_count = sum(1 for r in results if r["verdict"] == "맞음")
        print(f"   {len(results)}장 중 {match_count}장 '맞음' 판정")

    print()
    print("----------------------------------------")
    print("프로그램 종료")
    print("----------------------------------------")


if __name__ == "__main__":
    main()
